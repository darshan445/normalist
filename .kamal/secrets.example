# Copy values from .env.docker, then add registry token:
#   cp .kamal/secrets.example .kamal/secrets
#
# Kamal-only: POSTGRES_PASSWORD must match DATABASE_PASSWORD (db accessory).

KAMAL_REGISTRY_PASSWORD=

RAILS_MASTER_KEY=
HOST=https://api.normalist.space
FRONTEND_URL=https://normalist.vercel.app
CORS_ORIGINS=https://normalist.vercel.app

SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
GEMINI_API_KEY=
OPENAI_API_KEY=

DATABASE_NAME=normalist_production
DATABASE_USERNAME=normalist_db
DATABASE_PASSWORD=
POSTGRES_PASSWORD=
DATABASE_PORT=5432

# Cloudflare R2 (Active Storage) — R2 → Manage R2 API Tokens + bucket
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET=
