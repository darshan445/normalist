HOST=https://api.normalist.space
FRONTEND_URL=https://normalist.vercel.app
CORS_ORIGINS=https://normalist.vercel.app

WEB_PORT=3000
WEB_CONCURRENCY=1
RAILS_LOG_LEVEL=info
RAILS_MASTER_KEY=
RAILS_ENV=production

SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Production on instance (db + redis in docker-compose.yml)
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=normalist_production
DATABASE_USERNAME=normalist
DATABASE_PASSWORD=
REDIS_URL=redis://redis:6379/0

# Cloudflare R2 (Active Storage in production)
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET=
